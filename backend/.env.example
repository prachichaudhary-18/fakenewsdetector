# Node.js API Backend Environment Variables
# Rename this file to .env and fill in the values

# Port for the Node service (default is 5000 or set by platform)
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname

# Secret key for JWT authentication (use a long random string)
JWT_SECRET=your_jwt_secret_here

# URL of the deployed Python ML service (ml_service)
# Example: https://ml-service-abc.onrender.com
FASTAPI_URL=http://localhost:8000
